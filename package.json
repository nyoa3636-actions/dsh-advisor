{
  "name": "dsh-advisor",
  "version": "0.1.0",
  "description": "Advisor/Executor flow for DeepSeek Harness (DSH), adapted from philipbrembeck/pi-advisor.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "advisor",
    "executor",
    "coding-agent",
    "model-routing"
  ],
  "homepage": "https://github.com/nyoa3636-actions/dsh-advisor",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyoa3636-actions/dsh-advisor.git"
  },
  "license": "MIT",
  "author": "Philip Brembeck; DSH port by nyoa3636-actions",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "cordis.patch.yml",
    "src",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js",
    "build": "node --check dsh/index.js",
    "test": "node --test test-dsh/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
